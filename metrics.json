      "label": "tab:policy_results",
      "public_label": "Task-specific policy learning results"
    },
    "demonstration_source": {
      "path": "paper/iclr2027/sections/appendix.tex",
      "label": "tab:policy_dataset_stats",
      "public_label": "Demonstration data splits"
    },
    "note": "Ten held-out augmented instances; base templates may appear in training. Policy evaluators differ and results must not be pooled. These results support task-specific adaptation, not general real-robot transfer."
  },
  "limitations": [
    {
      "id": "qualitative_vs_quantitative",
      "text": "The selected scenes and operation videos are qualitative examples; the rates above come from the separate TabletopAudit benchmark.",
      "source": {
        "path": "paper/iclr2027/sections/experiments.tex",
        "label": "sec:exp_embodied",
        "public_label": "Simulation validity and embodied execution"
      }
    },
    {
      "id": "target_stability",
      "text": "STAB evaluates target-level settling under a fixed task profile. Non-target clutter is rendered but excluded from collision in that mode.",
      "source": {
        "path": "paper/iclr2027/sections/appendix.tex",
        "label": "app:embodied100",
        "public_label": "Simulator and target-stability protocol"
      }
    },
    {
      "id": "rigid_collision_scope",
      "text": "In physical PICK replay, clutter collisions are disabled; obstacle-collision evidence comes from planning.",
      "source": {
        "path": "paper/iclr2027/sections/appendix.tex",
        "label": "app:embodied100",
        "public_label": "RigidManip-60 protocol"
      }
    },
    {
      "id": "articulated_goal",
      "text": "Goal attainment during execution with measured contact and base-drift checks; sustained or terminal goal holding is not required.",
      "source": {
        "path": "paper/iclr2027/sections/appendix.tex",
        "label": "app:embodied100",
        "public_label": "Articulation-40 protocol"
      }
    },
    {
      "id": "missing_evidence",
      "text": "Applicable unknown outcomes remain in pass-rate denominators. Main result tables do not separately tabulate coverage or valid appearance-case counts.",
      "source": {
        "path": "paper/iclr2027/sections/appendix.tex",
        "label": "app:scoring",
        "public_label": "Scoring and aggregation"
      }
    },
    {
      "id": "no_uncertainty_claim",
      "text": "The active result tables report point estimates without confidence intervals or repeated-run variation. No statistical-significance claim is made here.",
      "source": {
        "path": "paper/iclr2027/sections/experiments.tex",
        "label": "sec:experiments",
        "public_label": "Experiments"
      }
    },
    {
