  "method_copy": {
    "summary": "TACER turns images or text into interactive tabletop scenes through hierarchical asset and scene programs, with verification-guided repair.",
    "steps": [
      {
        "title": "Understand the scene",
        "text": "Identify objects, support surfaces, and spatial relations."
      },
      {
        "title": "Build the assets",
        "text": "Construct geometry and physical representations, including joints for articulated objects."
      },
      {
        "title": "Assemble the scene",
        "text": "Place assets in dependency order using a scene-level program."
      },
      {
        "title": "Verify and repair",
        "text": "Check relations, physical stability, and motion clearance; revise and replay the responsible code."
      }
    ],
    "output": "Executable programs, 3D scenes, and verification evidence.",
    "source": {
      "path": "paper/iclr2027/sections/method_new.tex",
      "label": "fig:tacer_pipeline",
      "public_label": "TACER method overview"
    },
    "note": "Construction checks and independent benchmark evaluation are distinct."
  },
  "downstream": {
    "priority": "secondary",
    "task": "Screwdriver-to-tray",
    "successful_demonstrations": 303,
    "clean_training_episodes": 232,
